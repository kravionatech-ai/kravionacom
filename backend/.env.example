# Existing backend settings
MONGO_URI=mongodb://127.0.0.1:27017/kraviona
DB_NAME=kraviona
PORT=5000
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Comma-separated frontend/admin origins allowed to call this API.
# Enter origins only (no path); a trailing slash is normalized automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.kraviona.com,https://kraviona.com,https://admin.kraviona.com,https://superadmin.kraviona.com

# Blog Web Push. Generate once with: npx web-push generate-vapid-keys
# Keep the private key only in the backend deployment environment.
WEB_PUSH_VAPID_SUBJECT=mailto:kravionatech@gmail.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend Production Email Integration ──────────────────────────────────────
# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Resend Webhook signing secret (Svix secret: whsec_...)
# Set up in Resend Dashboard -> Webhooks -> Add Webhook endpoint -> Signing Secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Verified sender identity in Resend
# Note: In development or before custom domain verification, can use onboarding@resend.dev
RESEND_FROM_EMAIL=Kraviona Support <support@kraviona.com>

# Super Admin notification inbox where website inquiries are forwarded
ADMIN_NOTIFICATION_EMAIL=kravionatech@gmail.com

# Base URLs for deep links in email notifications and templates
APP_BASE_URL=https://www.kraviona.com
ADMIN_BASE_URL=https://admin.kraviona.com

# Receiving domain/subdomain configured in Resend (e.g., inbound.kraviona.com or kraviona.com)
INBOUND_EMAIL_DOMAIN=kraviona.com
