# ==============================================================================
# Nginx Configuration for Kraviona.com
# Enforces Canonical Host: https://www.kraviona.com
# Permanent (301) Consolidation of HTTP & Apex domain (kraviona.com)
# ==============================================================================

# 1. HTTP Server - Redirects all HTTP traffic (apex and www) directly to HTTPS www
server {
    listen 80;
    listen [::]:80;
    server_name kraviona.com www.kraviona.com;

    # Let's Encrypt / Certbot ACME webroot challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Permanent 301 redirect to preferred canonical HTTPS domain
    location / {
        return 301 https://www.kraviona.com$request_uri;
    }
}

# 2. HTTPS Apex Redirect - Consolidate https://kraviona.com -> https://www.kraviona.com
